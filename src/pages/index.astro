---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScreenshotShowcase from '../components/ScreenshotShowcase.astro';
import ReviewWall from '../components/ReviewWall.astro';
import site from '../data/site.json';
---

<BaseLayout>
<!-- Subtle Announcement Pill (Place above Hero Title in index.astro) -->
<div class="mb-6 flex justify-center">
  <a
    href="/press"
    class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-sm font-medium bg-[#39a5c0]/10 text-[#39a5c0] border border-[#39a5c0]/20 hover:bg-[#39a5c0]/20 transition-colors"
  >
    <span class="px-2 py-0.5 text-xs font-bold uppercase bg-[#39a5c0] text-white rounded-full">New</span>
    <span>WristTrack 2.0 is here — Read the 3-Year Anniversary Press Release →</span>
  </a>
</div>
  <!-- Hero Section -->
  <section id="download" class="relative overflow-hidden py-20 sm:py-28">
    <!-- Subtle Brand Teal Ambient Glow -->
    <div
      class="pointer-events-none absolute -top-24 left-1/2 -z-10 h-96 w-96 -translate-x-1/2 rounded-full bg-brand-500/15 blur-3xl"
    ></div>

    <div class="mx-auto max-w-6xl px-4 text-center sm:px-6">
      <!-- App Icon Hero Badge -->
      <div class="mx-auto mb-6 flex justify-center">
        <img
          src="/app-icon.png"
          alt="WristTrack App Icon"
          class="h-20 w-20 rounded-[1.35rem] shadow-2xl shadow-brand-500/20 ring-1 ring-white/15 sm:h-24 sm:w-24"
        />
      </div>

      <a
        href="/changelog"
        class="inline-flex items-center gap-2 rounded-full border border-brand-500/35 bg-brand-500/10 px-3.5 py-1.5 text-xs font-medium text-brand-300 transition hover:bg-brand-500/20"
      >
        <span class="rounded-full bg-brand-500 px-2 py-0.5 text-[10px] font-bold uppercase text-slate-950">New</span>
        WristTrack 2.0 is live — Optional Cloud Sync, iPad Support & More →
      </a>

      <h1 class="mx-auto mt-6 max-w-3xl text-4xl font-extrabold tracking-tight text-white sm:text-6xl">
        Your Digital Watch Box, <span class="text-brand-400">Built for Watch Nerds.</span>
      </h1>

      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-300">
        {site.description}
      </p>

      <!-- App Store & Play Store CTA Buttons -->
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a
          href={site.appStoreUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 rounded-xl bg-white px-6 py-3.5 text-left text-slate-950 shadow-lg transition hover:bg-slate-200"
        >
          <svg class="h-7 w-7 fill-current" viewBox="0 0 24 24">
            <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.96 6.33c.64-.78 1.08-1.86.96-2.94-.93.04-2.06.62-2.72 1.4-.58.68-1.1 1.78-.96 2.84 1.04.08 2.08-.52 2.72-1.3z" />
          </svg>
          <div>
            <div class="text-[10px] font-semibold uppercase tracking-wider text-slate-600">Download on the</div>
            <div class="text-base font-bold leading-tight">App Store</div>
          </div>
        </a>

        <a
          href={site.playStoreUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-3 rounded-xl border border-slate-700 bg-slate-900 px-6 py-3.5 text-left text-white shadow-lg transition hover:border-brand-500 hover:bg-slate-800"
        >
          <svg class="h-6 w-6 fill-brand-400" viewBox="0 0 24 24">
            <path d="M3 20.5v-17c0-.83.94-1.3 1.6-.8l14 8.5c.6.37.6 1.23 0 1.6l-14 8.5c-.66.5-1.6.03-1.6-.8z" />
          </svg>
          <div>
            <div class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Get it on</div>
            <div class="text-base font-bold leading-tight">Google Play</div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- Interactive Screenshot Gallery -->
  <ScreenshotShowcase />

  <!-- Features Grid (Driven by src/data/site.json) -->
  <section id="features" class="py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Everything You Need to Track Your Box</h2>
        <p class="mt-3 text-slate-400">
          Built for collectors who love data, accuracy, and privacy.
        </p>
      </div>

      <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {site.features.map((feature) => (
          <div class="rounded-2xl border border-slate-800 bg-slate-900/50 p-6 transition hover:border-brand-500/50">
            <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-500/15 text-brand-400">
              <span class="text-lg font-bold">✦</span>
            </div>
            <h3 class="mt-4 text-lg font-semibold text-white">{feature.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-400">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Store Reviews Wall -->
  <ReviewWall />

  <!-- Indie Maker / Watch Nerd Story Section -->
  <section id="about" class="border-t border-slate-800/80 bg-slate-900/40 py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <div class="rounded-3xl border border-brand-500/25 bg-slate-900/80 p-8 sm:p-10">
        <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center">
          <img
            src="/app-icon.png"
            alt="WristTrack Icon"
            class="h-16 w-16 shrink-0 rounded-2xl shadow-lg ring-1 ring-white/10"
          />
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-brand-400">Independent & Passion-Built</span>
            <h2 class="mt-1 text-2xl font-bold text-white sm:text-3xl">
              Made by a Watch Enthusiast & Data Nerd, for Watch Enthusiasts & Data Nerds
            </h2>
          </div>
        </div>

        <div class="mt-6 space-y-4 text-sm leading-relaxed text-slate-300 sm:text-base">
          <p>
            WristTrack isn't backed by a big studio or venture capital—it's designed, coded, and maintained by a sole developer who wanted a genuinely useful way to track wrist time, measure mechanical drift against atomic time, and geek out over collection stats.
          </p>
          <p>
            Because it's built by a fellow collector, the core features are always free, your watch data stays local-first on your device unless you choose to sync it, and new updates are shaped directly by feedback from the watch community.
          </p>
        </div>

        <div class="mt-6 flex flex-wrap items-center gap-4 border-t border-slate-800 pt-6 text-xs text-slate-400">
          <span>Have a feature idea or feedback?</span>
          <a href={`mailto:${site.email}`} class="font-semibold text-brand-400 hover:text-brand-300">
            Email {site.email} →
          </a>
          <span class="text-slate-700">•</span>
          <a href="/changelog" class="font-semibold text-slate-300 hover:text-white">
            Read the full dev changelog →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Merch & Blog Callout Banner -->
  <section class="py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="flex flex-col items-start justify-between gap-8 rounded-3xl border border-slate-800 bg-gradient-to-br from-slate-900 to-slate-950 p-8 sm:p-12 lg:flex-row lg:items-center">
        <div class="max-w-xl">
          <span class="text-xs font-bold uppercase tracking-wider text-brand-400">WristTrack Community</span>
          <h2 class="mt-2 text-2xl font-bold text-white sm:text-3xl">Explore the WristTrack Blog & Merch Store</h2>
          <p class="mt-3 text-sm leading-relaxed text-slate-300">
            Read deep-dives on watch collecting and app updates on our blog, or grab organic cotton watch-nerd tees, mugs, and stickers to support ongoing development.
          </p>
        </div>

        <div class="flex flex-wrap gap-3">
          <a
            href={site.merchStoreUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-xl bg-brand-500 px-5 py-3 text-sm font-bold text-slate-950 transition hover:bg-brand-400"
          >
            Visit Merch Store ↗
          </a>
          <a
            href={site.blogUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-xl border border-slate-700 bg-slate-800 px-5 py-3 text-sm font-semibold text-slate-200 transition hover:border-brand-500 hover:text-white"
          >
            Read the Blog ↗
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
