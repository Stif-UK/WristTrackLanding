---
import '../styles/global.css';
import site from '../data/site.json';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} — ${site.tagline}`,
  description = site.description,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="apple-itunes-app" content={`app-id=${site.iosAppId}`} />
    <link rel="icon" type="image/png" href="/favicon.png" />
  </head>
  <body class="bg-slate-950 text-slate-100 antialiased selection:bg-brand-500 selection:text-slate-950">
    <!-- Top Navbar -->
    <header class="sticky top-0 z-50 border-b border-slate-800/80 bg-slate-950/85 backdrop-blur-md">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3.5 sm:px-6">
        <a href="/" class="flex items-center gap-3 text-lg font-bold tracking-tight text-white">
          <img
            src="/app-icon.png"
            alt="WristTrack App Icon"
            class="h-9 w-9 rounded-xl shadow-sm ring-1 ring-white/10"
          />
          <span>{site.name}</span>
        </a>

        <nav class="hidden items-center gap-7 text-sm font-medium text-slate-300 md:flex">
          <a href="/#features" class="transition hover:text-brand-400">Features</a>
          <a href="/#screenshots" class="transition hover:text-brand-400">Screenshots</a>
          <a href="/#reviews" class="transition hover:text-brand-400">Reviews</a>
          <a href="/#about" class="transition hover:text-brand-400">About</a>
          <a href="/changelog" class="transition hover:text-brand-400">What's New</a>
          <a href="/faqs" class="transition hover:text-brand-400">FAQs</a>
          <a
            href={site.merchStoreUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-full border border-slate-700 bg-slate-900 px-3.5 py-1.5 text-xs font-semibold text-slate-200 transition hover:border-brand-500 hover:text-white"
          >
            Merch & Blog ↗
          </a>
        </nav>

        <a
          href="/#download"
          class="rounded-full bg-brand-500 px-4 py-2 text-xs font-bold text-slate-950 shadow-sm transition hover:bg-brand-400 sm:text-sm"
        >
          Get the App
        </a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-slate-800 bg-slate-950 py-12 text-sm text-slate-400">
      <div class="mx-auto max-w-6xl px-4 sm:px-6">
        <div class="grid gap-8 sm:grid-cols-2 md:grid-cols-4">
          <div>
            <div class="flex items-center gap-2.5">
              <img src="/app-icon.png" alt="WristTrack Icon" class="h-7 w-7 rounded-lg" />
              <p class="font-bold text-white">{site.name}</p>
            </div>
            <p class="mt-3 text-xs leading-relaxed text-slate-400">
              {site.tagline}. Made by a sole developer, watch enthusiast, and data nerd for fellow collectors.
            </p>
          </div>

          <div>
            <p class="font-semibold text-slate-200">App</p>
            <ul class="mt-3 space-y-2 text-xs">
              <li><a href="/#features" class="hover:text-brand-400">Features</a></li>
              <li><a href="/changelog" class="hover:text-brand-400">Changelog (v2.0.0)</a></li>
              <li><a href="/faqs" class="hover:text-brand-400">FAQs</a></li>
            </ul>
          </div>

          <div>
            <p class="font-semibold text-slate-200">Community & Store</p>
            <ul class="mt-3 space-y-2 text-xs">
              <li><a href={site.merchStoreUrl} target="_blank" rel="noopener" class="hover:text-brand-400">Official Merch Store ↗</a></li>
              <li><a href={site.blogUrl} target="_blank" rel="noopener" class="hover:text-brand-400">WristTrack Blog ↗</a></li>
              <li><a href={site.instagramUrl} target="_blank" rel="noopener" class="hover:text-brand-400">Instagram ↗</a></li>
              <li><a href={`mailto:${site.email}`} class="hover:text-brand-400">Contact Developer</a></li>
              <a href="/press" class="hover:text-[#39a5c0] transition-colors">
  Press Release (v2.0)
</a>
            </ul>
          </div>

          <div>
            <p class="font-semibold text-slate-200">Legal & Data</p>
            <ul class="mt-3 space-y-2 text-xs">
              <li><a href="/privacypolicy" class="hover:text-brand-400">Privacy Policy</a></li>
              <li><a href="/terms_and_conditions" class="hover:text-brand-400">Terms & Conditions</a></li>
              <li><a href="/delete_account" class="hover:text-brand-400">Account & Data Deletion</a></li>
            </ul>
          </div>
        </div>

        <div class="mt-10 border-t border-slate-800/80 pt-6 text-xs text-slate-500">
          © {new Date().getFullYear()} WristTrack. Built in Scotland by Grant Hutchison.
        </div>
      </div>
    </footer>
  </body>
</html>
