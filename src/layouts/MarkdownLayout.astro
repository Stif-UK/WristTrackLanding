---
import BaseLayout from './BaseLayout.astro';
const { frontmatter } = Astro.props;
---

<BaseLayout title={`${frontmatter.title} — WristTrack`}>
  <section class="py-16 sm:py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <article class="prose prose-invert prose-slate max-w-none prose-headings:scroll-mt-24 prose-a:text-brand-400 hover:prose-a:text-brand-300">
        <slot />
      </article>
    </div>
  </section>
</BaseLayout>
